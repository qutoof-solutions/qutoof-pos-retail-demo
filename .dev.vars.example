# Copy to .dev.vars for local Pages development. Never commit real secrets.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SUPER_ADMIN_BOOTSTRAP_SECRET=replace-with-a-one-time-random-secret-at-least-32-characters-long
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:8788
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ENCRYPTION_KEY=
WHATSAPP_CRON_SECRET=
WHATSAPP_GRAPH_API_VERSION=v23.0
# Telegram credentials are server-side only; never expose them as NEXT_PUBLIC_* values.
TELEGRAM_BOT_TOKEN=
# Preferred target chat. TELEGRAM_ADMIN_CHAT_ID remains a compatibility fallback.
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_ADMIN_ACCOUNT_ID=
TELEGRAM_WEBHOOK_SECRET=
BILLING_CRON_SECRET=
APP_BASE_URL=https://your-qutoof-domain.example
