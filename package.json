{
  "name": "qutoof-crm-2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "pages:build": "npx @cloudflare/next-on-pages",
    "preview": "wrangler pages dev .vercel/output/static --compatibility-date=2026-10-08",
    "deploy": "wrangler pages deploy .vercel/output/static",
    "lint": "eslint app components lib tests drizzle.config.ts next.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "extract:i18n": "tsx scripts/extract-all-arabic-strings.ts",
    "check:i18n": "tsx scripts/check-i18n-static-text.ts",
    "check:i18n:strict": "tsx scripts/check-i18n-static-text.ts --strict",
    "verify": "npm run typecheck && npm run lint && npm run check:i18n:strict && npm test && npm run build",
    "test:integration": "python3 scripts/phase4-integration.py",
    "test:inventory": "python3 scripts/inventory-integration.py",
    "test:api": "python3 scripts/tenant-isolation-api.py",
    "db:generate": "drizzle-kit generate",
    "cron:dev": "wrangler dev --config wrangler.whatsapp-cron.toml",
    "cron:deploy": "wrangler deploy --config wrangler.whatsapp-cron.toml",
    "db:migrate:local": "wrangler d1 migrations apply qutoof-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply qutoof-db --remote"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "framer-motion": "^14.0.0",
    "jose": "^6.1.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.468.0",
    "next": "15.5.27",
    "next-intl": "^4.14.9",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^22.18.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.35.0",
    "eslint-config-next": "15.5.27",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "postcss": "^8.5.29",
    "sharp": "^0.35.5"
  }
}
